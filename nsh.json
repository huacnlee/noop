{
  "name": "Noop",
  "id": "dev.noop.app",
  "version": "1.0.1",
  "build": 1,
  "entry": "app/App.tsx",
  "features": [
    "websocket"
  ],
  "updater": {
    "url": "https://noop.allsum.io/api/updates/direct/latest.json",
    "publicKey": "th7UtLhBOa73Bx2s+DZlmlH4EhKcxk5YLYHZQxSgb6I=",
    "packages": {
      "roots": [
        "SJl1kuuXiy0WqZM03S0Q16OIGNX7e+RTI8H5Flk8JLo="
      ]
    }
  },
  "appearance": "system",
  "theme": "app/theme.json",
  "web": {
    "host": "./app/host.js"
  },
  "capabilities": {
    "application": true,
    "clipboard": true,
    "statusBar": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "page",
      "pushState",
      "pushEnable",
      "pushDisable",
      "setSession",
      "setBadge",
      "clearNotifications",
      "vibrate"
    ],
    "picker": true,
    "speech": true,
    "notifications": true,
    "fs": {
      "read": [
        "${homeDir}"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "mailto"
      ]
    }
  },
  "icon": "app/icon.png",
  "store": {
    "ios": {
      "appId": "6835723652",
      "usesNonExemptEncryption": false,
      "release": "auto"
    },
    "linux": {
      "license": "MIT",
      "developer": "Jason Lee",
      "homepage": "https://huacnlee.github.io/noop/",
      "categories": [
        "Development"
      ],
