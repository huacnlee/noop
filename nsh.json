      ],
      "archiveUrl": "https://github.com/huacnlee/noop/releases/download/v{version}/noop-{version}-linux-x86_64.tar.gz"
    },
    "windows": {
      "productId": "9P8G3V5WV3T9"
    }
  },
  "windows": {
    "identityName": "huacnlee.NoopAgent",
